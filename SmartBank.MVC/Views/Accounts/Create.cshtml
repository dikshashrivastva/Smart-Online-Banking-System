@model SmartBank.Models.DTOs.Customer.CreateAccountRequestDto
@{
    ViewData["Title"] = "Open Account";
}

<div class="row g-4 align-items-start">
    <div class="col-lg-5">
        <div class="hero-panel h-100 d-block">
            <p class="eyebrow mb-2">New account</p>
            <h2 class="h1">Start a fresh balance space.</h2>
            <p>Choose savings for personal goals or current for everyday banking. Your new account appears in the accounts workspace after creation.</p>
            <div class="metric-card mt-4 bg-white border-0">
                <span class="metric-icon teal"><i class="bi bi-lightning-charge"></i></span>
                <div>
                    <span>Setup time</span>
                    <strong>Under a minute</strong>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-7">
        <div class="data-card">
            <h2>Open Account</h2>
            <p class="subtitle mb-4">Create a new savings or current account.</p>

            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="All" class="alert alert-danger py-2" style="display:@(ViewData.ModelState.ErrorCount > 0 ? "block" : "none")"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="AccountType" class="form-label">Account Type</label>
                        <select asp-for="AccountType" class="form-select">
                            <option>Savings</option>
                            <option>Current</option>
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="InitialDeposit" class="form-label">Initial Deposit</label>
                        <input asp-for="InitialDeposit" class="form-control" type="number" min="0" step="0.01" />
                        <span asp-validation-for="InitialDeposit" class="text-danger small"></span>
                    </div>
                </div>

                <div class="d-flex flex-wrap gap-2 mt-4">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-plus-circle me-2"></i>Open Account
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
