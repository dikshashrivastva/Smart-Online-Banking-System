@{
    ViewData["Title"] = "Dashboard";
}

<div class="row mt-4">
    <div class="col-12">
        <div class="alert alert-success">
            <h4 class="alert-heading">Sprint 1 &amp; 2 Ready</h4>
            <p>You are logged in successfully. JWT token is stored in your browser cookie.</p>
        </div>
    </div>
</div>

<div class="row g-3 mt-2">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm text-center p-3">
            <h6 class="mt-2 fw-bold">Authentication</h6>
            <p class="text-muted small">JWT secured login complete</p>
            <span class="badge bg-success">Done</span>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm text-center p-3">
            <h6 class="mt-2 fw-bold">Customer Profile</h6>
            <p class="text-muted small">View and edit profile details</p>
            <a asp-controller="Profile" asp-action="Index" class="btn btn-outline-primary btn-sm">My Profile</a>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm text-center p-3">
            <h6 class="mt-2 fw-bold">Accounts</h6>
            <p class="text-muted small">List accounts and open a new account</p>
            <a asp-controller="Accounts" asp-action="Index" class="btn btn-outline-primary btn-sm">My Accounts</a>
        </div>
    </div>
</div>
