<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] – SmartBank</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/smartbank.css" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
        <div class="container">
            <a class="navbar-brand fw-bold" href="/">🏦 SmartBank</a>
            <div class="ms-auto d-flex gap-2">
                @if (Context.Request.Cookies.ContainsKey("SmartBankToken"))
                {
                    <a class="btn btn-outline-light btn-sm" asp-controller="Dashboard" asp-action="Index">Dashboard</a>
                    <a class="btn btn-outline-light btn-sm" asp-controller="Profile" asp-action="Index">My Profile</a>
                    <a class="btn btn-outline-light btn-sm" asp-controller="Accounts" asp-action="Index">My Accounts</a>
                    <a class="btn btn-outline-light btn-sm" asp-controller="Auth" asp-action="Logout">Logout</a>
                }
                else
                {
                    <a class="btn btn-outline-light btn-sm" asp-controller="Auth" asp-action="Login">Login</a>
                    <a class="btn btn-light btn-sm text-primary fw-bold" asp-controller="Auth" asp-action="Register">Register</a>
                }
            </div>
        </div>
    </nav>

    <main class="container py-4">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show">
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @RenderBody()
    </main>

    <footer class="text-center text-muted py-3 border-top">
        <small>&copy; @DateTime.Now.Year SmartBank - Sprint 1 &amp; 2</small>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
