@model SmartBank.Models.DTOs.Transactions.TransactionFormViewModel
@{
    ViewData["Title"] = "Withdraw";
}

<section class="section-heading mt-0">
    <div>
        <p class="eyebrow mb-1">Money out</p>
        <h2>Withdraw funds</h2>
        <p>Daily withdrawals are capped at INR 100,000 per account.</p>
    </div>
    <a asp-action="History" class="btn btn-outline-primary"><i class="bi bi-clock-history me-2"></i>History</a>
</section>

<section class="data-card transaction-card">
    <form asp-action="Withdraw" method="post" data-balance-refresh>
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="AccountId" class="form-label">Account</label>
                <select asp-for="AccountId" class="form-select" data-account-select>
                    <option value="">Select account</option>
                    @foreach (var account in Model.Accounts)
                    {
                        <option value="@account.AccountId">@account.AccountNumber - @account.AccountType (@account.Currency @account.Balance.ToString("N2"))</option>
                    }
                </select>
            </div>
            <div class="col-md-6">
                <label asp-for="Amount" class="form-label">Amount</label>
                <input asp-for="Amount" class="form-control" type="number" min="0.01" step="0.01" />
            </div>
            <div class="col-12">
                <label asp-for="Description" class="form-label">Description</label>
                <textarea asp-for="Description" class="form-control" rows="3" maxlength="500"></textarea>
            </div>
        </div>
        <div class="transaction-balance mt-3" data-balance-output>Available balance updates after selection.</div>
        <div class="mt-4">
            <button class="btn btn-primary" type="submit"><i class="bi bi-cash-coin me-2"></i>Withdraw</button>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/transactions.js"></script>
}
